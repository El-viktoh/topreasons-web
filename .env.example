# Supabase — replace with your project values from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Flutterwave Keys
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your-public-key-here
FLUTTERWAVE_SECRET_KEY=your-secret-key-here
FLUTTERWAVE_SECRET_HASH=your-secret-hash-here

# Resend API Key for Emails
RESEND_API_KEY=your-resend-api-key-here
